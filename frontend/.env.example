# ==========================================
# The ONE Platform - Frontend Environment Variables
# ==========================================
# Render backend gateway URL (without trailing slash)
# Example: https://the-one-backend.onrender.com
VITE_SERVER_URL=https://your-backend.onrender.com
# Firebase Client API Key
VITE_FIREBASE_API_KEY=AIzaSy...
# Razorpay Key ID
VITE_RAZORPAY_KEY_ID=rzp_test_...