# ==========================================
# The ONE Platform - Backend Environment Variables
# ==========================================
# 1. Gateway & Networking
PORT=8000
FRONTEND_URL=https://your-frontend.vercel.app
# 2. Redis Session & Cache (e.g. Upstash Redis, Redis Cloud, or Render Redis)
# Example: rediss://default:password@your-endpoint.upstash.io:6379
REDIS_URL=redis://localhost:6379
# 3. Database (MongoDB Atlas)
# Can provide a shared connection string:
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/the_one?retryWrites=true&w=majority
# Or optionally individual databases:
# AUTH_MONGODB_URI=mongodb+srv://.../auth
# CHAT_MONGODB_URI=mongodb+srv://.../chat
# AGENT_MONGODB_URI=mongodb+srv://.../agent
# BILLING_MONGODB_URI=mongodb+srv://.../billing
# 4. Firebase Authentication (Auth Service)
# Paste the entire content of serviceAccountKey.json as a raw JSON string or Base64 string
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"...","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"...","client_id":"...","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token"}
# 5. LLMs & Agent APIs (Agent Service)
GROQ_API_KEY=gsk_...
GOOGLE_API_KEY=AQ...
TAVILY_API_KEY=tvly-...
OPENROUTER_API_KEY=sk-or-v1-...
# 6. AWS S3 Storage (Agent Service)
AWS_REGION=eu-north-1
AWS_ACCESS_KEY_ID=AKIA...
AWS_SECRET_KEY=...
AWS_BUCKET_NAME=your-bucket-name
# 7. Qdrant Vector Store (Agent Service)
QDRANT_API_KEY=...